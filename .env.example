# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key

# Google OAuth (for GSC + GA4)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://openclawseo.vercel.app/api/v1/integrations/gsc/callback

# Framer
FRAMER_API_KEY=your-framer-api-key
FRAMER_PROJECT_ID=your-framer-project-id

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Encryption
ENCRYPTION_SECRET=your-32-char-secret-for-aes-256!!

# Agent microservice
AGENT_SERVICE_URL=http://localhost:8000
AGENT_WEBHOOK_SECRET=your-webhook-secret

# App
NEXT_PUBLIC_APP_URL=https://openclawseo.vercel.app
NEXT_PUBLIC_SANDBOX_DOMAIN=sandbox.localhost
